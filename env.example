# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://zuvre:zuvre@localhost:5432/zuvre_dev

# ---- Auth ----
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_SESSION_COOKIE_NAME=zuvre_session

# ---- AI Gateway (all optional at boot; providers register only if configured) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_TEXT_PROVIDER=anthropic
AI_DEFAULT_TEXT_MODEL=claude-sonnet-4-6

# ---- Observability ----
LOG_LEVEL=info
SENTRY_DSN=

# ---- Feature flags / plan defaults ----
DEFAULT_PLAN_ID=ember

# ---- LOCAL DEMO MODE (development only — see docs/11-local-demo-mode.md) ----
# Browser-only demo sign-in/sign-up so ZUVRE can be explored with NO database and NO secrets.
# It is ignored by production builds, whatever this is set to. Next.js reads env files from
# apps/web/, so for `pnpm dev` put this line in apps/web/.env.local — or just run `pnpm dev:demo`.
NEXT_PUBLIC_ZUVRE_LOCAL_DEMO=1
